# Docker settings for this machine. Copy to .env (docker compose reads it
# automatically) and adjust. .env is git-ignored, so `git pull` never touches it.

# Run the containers as your user so downloaded files aren't owned by root.
# Find the values with `id -u` and `id -g`. Create the download folder first
# (mkdir -p downloads) so it belongs to you too.
PUID=1000
PGID=1000

# Where downloads are stored on this machine (default: ./downloads)
# DOWNLOAD_DIR=/mnt/media/youtube

# Time zone for scheduled downloads and timestamps
TZ=Asia/Seoul

# Address the ports are published on. Keep 127.0.0.1 and reach the app through
# Tailscale Serve (docs/SERVER.md); 0.0.0.0 opens it to your whole network.
BIND_ADDR=127.0.0.1

# Needed to use the REST API from other devices. Generate with: openssl rand -hex 32
# API_TOKEN=
